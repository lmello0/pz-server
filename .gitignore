# pz-server/.gitignore

# Holds your Cloudflare API token, admin IP, and key paths - never commit
terraform.tfvars
terraform.tfvars.bak
*.auto.tfvars

# State contains every generated password in plaintext
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Provider binaries and module cache - re-downloaded by `terraform init`
.terraform/

# Saved plan files can contain secrets too
*.tfplan

# Crash logs
crash.log
crash.*.log

# Packer build artifacts
packer/manifest.json
packer/packer_cache/
*.pkrvars.hcl

*.bak